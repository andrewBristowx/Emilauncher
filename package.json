{
  "name": "emilauncher",
  "version": "0.5.0",
  "description": "Launcher propio y actualizable para Emipokemon / Cobbleverse",
  "main": "src/main.js",
  "author": "Emi / Pony0n",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/functional-v05.js && node --check src/minecraft-runtime.js && node --check src/minecraft-auth.js",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@azure/msal-node": "5.4.2",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/user": "4.3.0",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.emipokemon.launcher",
    "productName": "EmiLauncher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "launcher-config.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "EmiLauncher-${version}-Windows-${arch}.${ext}"
    }
  }
}
