{
  "name": "emilauncher",
  "version": "0.6.0",
  "description": "Instalador y actualizador simplificado de Emipokemon / EmiCobleverse",
  "main": "src/main-v06.js",
  "author": "Emi / Pony0n",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main-v06.js && node --check src/preload-v06.js && node --check src/renderer-v06.js && node --check src/minecraft-runtime.js && node --check src/official-launcher-bridge.js",
    "test": "node --test tests/runtime.test.js tests/v06.test.js",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.emipokemon.launcher",
    "productName": "EmiLauncher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "EmiLauncher-${version}-Windows-${arch}.${ext}"
    }
  }
}
